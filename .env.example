NODE_ENV=development
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
AUTH_SECRET=replace-with-a-long-random-secret

DB_HOST=127.0.0.1
